# ============================================================================
# Gamza Market - Environment Variables Template
# ============================================================================
# 이 파일을 복사하여 .env 파일을 생성한 뒤 실제 키 값을 입력하세요.
# 주의: .env 파일은 민감한 키가 포함되므로 깃허브에 절대 커밋하지 마세요!

# 1. Supabase 프로젝트 접속 URL
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon 공개 키 (프론트엔드 브라우저용)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role 비밀 키 (관리자/백엔드용, 공개 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Supabase Personal Access Token (Management API / CLI 용, 'sbp_' 시작)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# 5. (선택) Supabase Project Ref ID
SUPABASE_PROJECT_REF=your-project-ref-id
