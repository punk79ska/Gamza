# ============================================================================
# Gamza Market - Git Ignore Rules
# ============================================================================

# 1. 환경 변수 및 인증 토큰 (보안 민감 정보)
.env
.env.local
.env.*.local
*.pem
*.key

# 2. IDE 및 에디터 로컬 설정
.cursor/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 3. 운영체제 메타데이터
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 4. 의존성 및 패키지 매니저
node_modules/
jspm_packages/
.pnp/
.pnp.js

# 5. 빌드 및 로그 파일
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. 임시 파일
tmp/
temp/
*.tmp
